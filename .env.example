# ---- Barkelou : configuration du serveur ----
NODE_ENV=production
PORT=3000

# Adresse publique du site (utilisée pour les retours et notifications PayDunya)
PUBLIC_URL=https://barkelou.com

# Base PostgreSQL (Neon, Supabase, Render, Railway, ou votre serveur)
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/barkelou
# Mettre true si votre hébergeur exige SSL (Neon, Supabase, Render…)
DATABASE_SSL=true

# Secrets : générez-les avec   npm run secrets
# Ne les partagez jamais et ne les commitez jamais.
JWT_SECRET=
ENCRYPTION_KEY=

# Nombre de proxys devant l'application (1 derrière Render / Railway / Nginx)
TRUST_PROXY=1

# Les clés PayDunya se saisissent dans l'espace admin (Paramètres › PayDunya), pas ici.
