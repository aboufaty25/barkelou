# ---- Barkelou : configuration du serveur ----
# Sur Hostinger, ajoutez ces variables dans hPanel › votre site › Variables d'environnement.

# Adresse publique du site (retours et notifications PayDunya)
PUBLIC_URL=https://barkelou.com

# Base MySQL Hostinger (hPanel › Bases de données › MySQL)
# Utilisez 127.0.0.1 et non « localhost ».
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u123456789_barkelou
DB_USER=u123456789_barkelou
DB_PASSWORD=

# Secrets : générez-les avec   npm run secrets   (ne les partagez jamais)
JWT_SECRET=
ENCRYPTION_KEY=

# Proxy devant l'application (Hostinger, Nginx…)
TRUST_PROXY=1

# Les clés PayDunya se saisissent dans l'espace admin (Paramètres › PayDunya), pas ici.

# Premier administrateur sans SSH : inscrivez-vous sur le site, mettez votre numéro ici, redémarrez.
# ADMIN_PHONE=77XXXXXXX
